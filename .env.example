# Server
PORT=3000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=reki_db

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Manchester City Config
DEFAULT_CITY=Manchester
DEFAULT_LAT=53.4808
DEFAULT_LNG=-2.2426

# Weather API (OpenWeatherMap - optional for MVP)
WEATHER_API_KEY=your-openweathermap-api-key

# Error Tracking (Sentry - optional)
SENTRY_DSN=your-sentry-dsn-url

# Firebase Push Notifications (optional for dev - mock mode if missing)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Apple Wallet (Phase 1 - optional)
APPLE_PASS_TYPE_ID=pass.com.reki.offers
APPLE_TEAM_ID=your-apple-team-id

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.reki.app
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Email Configuration
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@reki.app
FRONTEND_URL=http://localhost:3001

# SendGrid (if using EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# AWS SES (if using EMAIL_PROVIDER=ses)
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# SMTP (if using EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Apple Wallet Certificates
APPLE_PASS_CERT_PATH=certs/pass.pem
APPLE_PASS_KEY_PATH=certs/key.pem
APPLE_PASS_WWDR_PATH=certs/wwdr.pem
APPLE_PASS_KEY_PASSWORD=
